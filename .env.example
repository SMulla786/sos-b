# Environment mode (development, production, test)
NODE_ENV=development

# Port number on which the server will run
PORT=3000

# Postgres URL
DATABASE_URL="postgresql://username:password@localhost:5432/sos?schema=public"

# Secret key used for signing JWT tokens (use a long random value)
JWT_SECRET=change_me

# Minutes after which access tokens expire
JWT_ACCESS_EXPIRATION_MINUTES=30

# Days after which refresh tokens expire
JWT_REFRESH_EXPIRATION_DAYS=30

# Minutes after which the reset password token expires
JWT_RESET_PASSWORD_EXPIRATION_MINUTES=10

# Minutes after which the email verification token expires
JWT_VERIFY_EMAIL_EXPIRATION_MINUTES=10

# bcrypt cost factor for password hashing (optional, default 12)
BCRYPT_SALT_ROUNDS=12

# SMTP server used for password reset emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=no-reply@example.com

# Comma-separated list of allowed origins for CORS (browser clients only; the Android app does not need this)
CORS_ORIGINS=http://localhost:3000
