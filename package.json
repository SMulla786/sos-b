{
    "name": "sos-backend",
    "version": "1.0.0",
    "main": "dist/index.js",
    "repository": "https://github.com/SMulla786/sos-b",
    "author": "Suhel Mulla",
    "_moduleAliases": {
        "@middlewares": "dist/middlewares",
        "@routes": "dist/routes",
        "@utils": "dist/utils",
        "@config": "dist/config",
        "@services": "dist/services",
        "@controllers": "dist/controllers",
        "@validations": "dist/validations",
        "@client": "dist/client.js"
    },
    "scripts": {
        "build": "tsc",
        "start": "node -r module-alias/register --env-file=.env dist/index.js",
        "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register --env-file=.env src/index.ts",
        "lint": "eslint src/**/*.{ts,tsx}",
        "lint:fix": "eslint src/**/*.{ts,tsx} --fix",
        "prettier": "prettier --check **/*.ts",
        "prettier:fix": "prettier --write **/*.ts",
        "format": "prettier --write src/**/*.{ts,tsx,js,jsx,json,css,md,mjs}",
        "prepare": "husky",
        "prisma:generate": "prisma generate",
        "prisma:migrate:dev": "prisma migrate dev",
        "prisma:migrate:deploy": "prisma migrate deploy",
        "prisma:studio": "prisma studio",
        "prisma:db:seed": "prisma db seed",
        "prisma:reset": "prisma migrate reset --force"
    },
    "lint-staged": {
        "src/**/*.{ts,tsx,js,jsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "src/**/*.{json,css,md,mjs}": [
            "prettier --write"
        ]
    },
    "keywords": [
        "express",
        "prisma",
        "typescript",
        "node",
        "backend",
        "api",
        "web",
        "middleware",
        "authentication"
    ],
    "license": "ISC",
    "dependencies": {
        "@prisma/client": "^5.21.1",
        "bcryptjs": "^2.4.3",
        "compression": "^1.7.4",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.5",
        "express": "^5.0.0",
        "express-rate-limit": "^7.4.0",
        "helmet": "^7.1.0",
        "http-status": "^1.7.4",
        "jsonwebtoken": "^9.0.2",
        "module-alias": "^2.2.3",
        "morgan": "^1.10.0",
        "nodemailer": "^6.10.1",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "winston": "^3.14.2",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.1.0",
        "@eslint/js": "^9.9.1",
        "@types/bcryptjs": "^2.4.6",
        "@types/compression": "^1.7.5",
        "@types/cookie-parser": "^1.4.7",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.6",
        "@types/morgan": "^1.9.9",
        "@types/node": "^22.5.1",
        "@types/nodemailer": "^6.4.15",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.6",
        "@typescript-eslint/eslint-plugin": "^8.3.0",
        "@typescript-eslint/parser": "^8.3.0",
        "eslint": "^9.9.1",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.2.1",
        "husky": "^9.1.5",
        "lint-staged": "^15.2.9",
        "prettier": "^3.3.3",
        "prisma": "^5.21.1",
        "ts-node-dev": "^2.0.0",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.5.4"
    }
}
